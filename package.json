*{box-sizing:border-box} body{margin:0;background:#f6f5f2;color:#0a0a0a;font-family:-apple-system,BlinkMacSystemFont,'Helvetica Neue',Arial,sans-serif} button,input,textarea{font:inherit}.screen{min-height:100vh;padding:28px 18px 120px;max-width:820px;margin:0 auto}.topbar{display:grid;grid-template-columns:74px 1fr auto;gap:14px;align-items:center}.logo{width:72px;height:72px;object-fit:contain}.brandBlock .kicker{font-weight:900;letter-spacing:.08em;font-size:13px}.brandBlock h1,.detail h1{font-size:44px;line-height:.9;margin:8px 0 0;font-weight:950;letter-spacing:-.06em}.adminBtn,.cartPill,.back,.primary,.bottomBar button{border:0;border-radius:999px;background:#0b0b0b;color:#fff;padding:12px 16px;font-weight:700}.cartPill{display:flex;gap:6px;align-items:center}.hero{margin:34px 0}.line{width:58px;height:5px;background:#0b0b0b;margin:18px 0}.hero p,.description,.muted{color:#626262;line-height:1.45}.search,input,textarea{width:100%;border:1px solid #dedbd4;border-radius:18px;background:#fff;padding:15px;margin-top:14px}.grid{display:grid;grid-template-columns:1fr;gap:18px}.card{background:#fff;border:1px solid #e7e3dc;border-radius:28px;padding:18px;text-align:left;box-shadow:0 14px 40px rgba(0,0,0,.05);overflow:hidden}.imageBox{height:210px;background:linear-gradient(180deg,#fff,#f4f2ed);border-radius:22px;display:flex;align-items:center;justify-content:center;margin-bottom:16px}.imageBox img,.detailImage img{max-width:100%;max-height:100%;object-fit:contain}.shoePlaceholder{text-align:center;color:#9b9b9b;text-transform:uppercase;letter-spacing:.05em}.shoePlaceholder.big{font-size:24px}.card h3{font-size:23px;margin:0 0 5px;font-weight:800;letter-spacing:-.03em}.card p{margin:0 0 16px;color:#606060}.cardFooter{border-top:1px solid #eee;padding-top:14px;display:flex;justify-content:space-between;gap:10px;align-items:center;font-size:14px}.detail .back,.adminHeader .back{display:inline-flex;align-items:center;gap:8px;background:#fff;color:#111;border:1px solid #e1ddd5}.detailLogo{width:86px;margin-top:30px}.subTitle{font-size:20px;margin:6px 0;color:#333}.detailImage{height:300px;margin:24px 0;background:#fff;border-radius:32px;display:flex;align-items:center;justify-content:center;border:1px solid #e6e1d8}.detail h2{font-size:20px;text-align:center}.sizes{display:flex;flex-wrap:wrap;gap:10px;margin:20px 0}.sizes button{border:1px solid #d8d3c9;border-radius:16px;background:#fff;padding:12px 16px}.sizes button.active{background:#111;color:#fff}.sizes button:disabled{opacity:.35;text-decoration:line-through}.bottomBar{position:fixed;left:14px;right:14px;bottom:18px;max-width:780px;margin:auto;background:rgba(255,255,255,.94);border:1px solid #dedbd4;border-radius:26px;padding:12px;display:grid;grid-template-columns:54px 1fr auto;gap:12px;align-items:center;box-shadow:0 12px 40px rgba(0,0,0,.12);font-weight:800}.miniLogo{border:2px solid #111;height:48px;display:flex;align-items:center;justify-content:center;font-size:24px;font-weight:950}.adminHeader{display:flex;justify-content:space-between;gap:12px;align-items:center}.adminScreen h1{font-size:38px;letter-spacing:-.04em}.adminList{display:grid;gap:12px;margin-top:20px}.adminRow{background:#fff;border:1px solid #e3ded5;border-radius:20px;padding:14px;display:grid;grid-template-columns:1fr 42px 42px 42px;gap:8px;align-items:center}.adminRow span{display:block;color:#777;margin-top:4px;font-size:13px}.adminRow button{height:42px;border:1px solid #e0dbd2;background:#fff;border-radius:13px}.editor{background:#fff;border:1px solid #dedbd4;border-radius:24px;padding:16px;display:grid;gap:12px}.editor label{font-weight:800}.editor textarea{min-height:90px}.upload{border:1px dashed #aaa;border-radius:18px;padding:16px;display:flex;gap:8px;align-items:center;justify-content:center}.upload input{display:none}.preview{max-width:100%;height:160px;object-fit:contain;background:#f7f7f7;border-radius:16px}.editorActions{display:flex;gap:10px}.editorActions button{border:1px solid #ddd;border-radius:14px;padding:12px 14px;background:#fff}.primary{display:inline-flex;gap:8px;align-items:center;background:#111!important;color:#fff!important}.muted{font-size:14px}@media(min-width:680px){.grid{grid-template-columns:1fr 1fr}.brandBlock h1,.detail h1{font-size:64px}.imageBox{height:250px}}
